# --- Banco e login (obrigatório) ---
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.donattiturismo.com.br
NEXT_PUBLIC_APP_URL=https://www.donattiturismo.com.br

# --- IA na AWS Bedrock (Claude + Nova Canvas) ---
