# --- Banco e login (obrigatório; são as que a produção já tem) ---
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
# Também aceitos no lugar: POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING / NEXTAUTH_SECRET
NEXTAUTH_URL=https://www.donattiturismo.com.br
NEXT_PUBLIC_APP_URL=https://www.donattiturismo.com.br

# --- IA na AWS Bedrock (opcional: sem ela o sistema funciona, só sem os botões de IA) ---
AWS_BEARER_TOKEN_BEDROCK=
# ou, no lugar do token: AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_CLAUDE_MODEL=anthropic.claude-opus-5-5
NOVA_CANVAS_REGION=us-east-1

# --- Imagens (opcional: S3 ou Supabase). Sem eles, as imagens ficam no banco (até 3MB) ---
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

UNSPLASH_ACCESS_KEY=

# --- Opcionais ---
GEMINI_API_KEY=
META_APP_ID=
META_APP_SECRET=
GOOGLE_ID_CLIENT=
GOOGLE_ID_CLIENT_SECRET=
NEXT_PUBLIC_GTM_ID=
