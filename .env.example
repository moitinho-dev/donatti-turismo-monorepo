# --- Banco e login (obrigatório; são as que a produção já tem) ---
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
# Também aceitos no lugar: POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING / NEXTAUTH_SECRET
NEXTAUTH_URL=https://donattiturismo.com
NEXT_PUBLIC_APP_URL=https://donattiturismo.com
NEXT_PUBLIC_SITE_URL=https://donattiturismo.com

# --- IA na AWS Bedrock (opcional: sem ela o sistema funciona, só sem os botões de IA) ---
AWS_BEARER_TOKEN_BEDROCK=
# ou, no lugar do token: AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=
# Claude (textos): perfil de inferência; um id puro "anthropic.*" vira "us.anthropic.*" sozinho
BEDROCK_REGION=us-east-1
BEDROCK_CLAUDE_MODEL=us.anthropic.claude-opus-5-5
# Imagens (Stability AI): geração no Core (só existe em us-west-2); edições pelos perfis us.stability.*
STABILITY_IMAGE_MODEL=stability.stable-image-core-v1:1
STABILITY_IMAGE_REGION=us-west-2
STABILITY_EDIT_REGION=us-west-2
# NOVA_CANVAS_* não é mais usada (o Nova Canvas saiu do Bedrock)

# --- Imagens (opcional: S3 ou Supabase). Sem eles, as imagens ficam no banco (até 3MB) ---
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

UNSPLASH_ACCESS_KEY=

# --- Opcionais ---
GEMINI_API_KEY=
META_APP_ID=
META_APP_SECRET=
# Login do Facebook para Empresas (token de usuário do sistema): publica na Página e no Instagram
META_LOGIN_CONFIG_ID=1855350682152497
GOOGLE_ID_CLIENT=
GOOGLE_ID_CLIENT_SECRET=
NEXT_PUBLIC_GTM_ID=
